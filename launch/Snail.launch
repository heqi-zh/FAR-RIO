<launch>
    <arg name="config_file" default="$(find far_rio)/config/Snail_radar.yaml" />
    <arg name="rviz" default="true" />
    <!-- Optional online replay: set an absolute bag path; leave empty for live sensors. -->
    <arg name="bag_file" default="" />

    <rosparam command="load" file="$(arg config_file)" />
    <param name="use_sim_time" value="$(eval arg('bag_file') != '')" />
    <param name="filter_size_surf" type="double" value="0.2" />
    <param name="filter_size_map" type="double" value="0.5" />
    <param name="cube_side_length" type="double" value="1000" />
    <param name="runtime_pos_log_enable" type="bool" value="false" />

    <node pkg="far_rio" type="run_mapping_online" name="radarMapping" output="screen">
        <param name="config_file" value="$(arg config_file)" />
    </node>
    <node if="$(eval arg('bag_file') != '')" pkg="rosbag" type="play" name="bag_player"
          args="--clock &quot;$(arg bag_file)&quot;" output="screen" />
    <node if="$(arg rviz)" launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find far_rio)/rviz_cfg/far_rio.rviz" />
</launch>
